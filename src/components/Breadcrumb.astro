---
// src/components/Breadcrumb.astro

export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center flex-wrap gap-1 text-sm" style="color: var(--text-muted);">
    <li>
      <a href="/" style="color: var(--text-muted);" class="hover:underline">Ana Sayfa</a>
    </li>
    {crumbs.map((crumb, i) => (
      <>
        <li aria-hidden="true" class="select-none">/</li>
        <li>
          {i === crumbs.length - 1 || !crumb.href ? (
            <span style="color: var(--text-primary);" aria-current="page">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href} style="color: var(--text-muted);" class="hover:underline">
              {crumb.label}
            </a>
          )}
        </li>
      </>
    ))}
  </ol>
</nav>
