---
// src/components/Card.astro
// Content listing card used in section index pages.

import Badge from './Badge.astro';
import TagChip from './TagChip.astro';

export interface Props {
  title: string;
  summary: string;
  href: string;
  level: 'giris' | 'orta' | 'ileri';
  tags?: string[];
  /** Optional supplementary label (e.g. module number, tool vendor) */
  meta?: string;
  updated?: Date;
}

const { title, summary, href, level, tags = [], meta } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-3 p-5 rounded-xl border transition-all hover:shadow-md focus-visible:outline-none focus-visible:ring-2"
  style="background-color: var(--bg-surface); border-color: var(--border-color); --tw-ring-color: var(--brand);"
>
  <!-- Header row -->
  <div class="flex items-start justify-between gap-3">
    <h3
      class="font-semibold text-base leading-snug group-hover:underline"
      style="color: var(--text-primary);"
    >
      {title}
    </h3>
    <Badge label={level} variant={`level-${level}`} class="shrink-0 mt-0.5" />
  </div>

  <!-- Summary -->
  <p class="text-sm leading-relaxed line-clamp-3" style="color: var(--text-secondary);">
    {summary}
  </p>

  <!-- Footer row -->
  <div class="flex items-center justify-between gap-2 mt-auto pt-1">
    <div class="flex flex-wrap gap-1">
      {tags.slice(0, 3).map((t) => (
        <TagChip tag={t} />
      ))}
    </div>
    {meta && (
      <span class="text-xs shrink-0" style="color: var(--text-muted);">{meta}</span>
    )}
  </div>
</a>
