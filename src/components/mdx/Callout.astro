---
// src/components/mdx/Callout.astro
// Colored callout box for MDX content.
// Used as: <Callout type="info" title="Optional title">...</Callout>

export interface Props {
  type: 'info' | 'uyari' | 'ipucu' | 'not';
  title?: string;
}

const { type, title } = Astro.props;

type CalloutConfig = {
  label: string;
  icon: string;
  borderStyle: string;
  bgStyle: string;
  titleStyle: string;
  textStyle: string;
};

const configs: Record<string, CalloutConfig> = {
  info: {
    label: 'Bilgi',
    icon: `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
    borderStyle: 'border-blue-300 dark:border-blue-700',
    bgStyle:     'bg-blue-50 dark:bg-blue-950/40',
    titleStyle:  'text-blue-800 dark:text-blue-300',
    textStyle:   'text-blue-900 dark:text-blue-200',
  },
  uyari: {
    label: 'Uyarı',
    icon: `<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
    borderStyle: 'border-amber-300 dark:border-amber-700',
    bgStyle:     'bg-amber-50 dark:bg-amber-950/40',
    titleStyle:  'text-amber-800 dark:text-amber-300',
    textStyle:   'text-amber-900 dark:text-amber-200',
  },
  ipucu: {
    label: 'İpucu',
    icon: `<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2.26C4.19 13.47 3 11.38 3 9a7 7 0 0 1 7-7z"/>`,
    borderStyle: 'border-emerald-300 dark:border-emerald-700',
    bgStyle:     'bg-emerald-50 dark:bg-emerald-950/40',
    titleStyle:  'text-emerald-800 dark:text-emerald-300',
    textStyle:   'text-emerald-900 dark:text-emerald-200',
  },
  not: {
    label: 'Not',
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
    borderStyle: 'border-violet-300 dark:border-violet-700',
    bgStyle:     'bg-violet-50 dark:bg-violet-950/40',
    titleStyle:  'text-violet-800 dark:text-violet-300',
    textStyle:   'text-violet-900 dark:text-violet-200',
  },
};

const cfg = configs[type] ?? configs['info']!;
const displayTitle = title ?? cfg.label;
---

<aside class={`not-prose my-6 flex gap-3 rounded-xl border p-4 ${cfg.borderStyle} ${cfg.bgStyle}`} role="note">
  <svg
    class={`shrink-0 mt-0.5 ${cfg.titleStyle}`}
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={cfg.icon}
  />
  <div class="flex-1 min-w-0">
    <p class={`font-semibold text-sm mb-1 ${cfg.titleStyle}`}>{displayTitle}</p>
    <div class={`text-sm leading-relaxed [&>p]:mb-2 [&>p:last-child]:mb-0 ${cfg.textStyle}`}>
      <slot />
    </div>
  </div>
</aside>
