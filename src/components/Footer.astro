---
// src/components/Footer.astro

import { footerColumns } from '@data/nav';
---

<footer
  class="border-t mt-16"
  style="background-color: var(--bg-surface); border-color: var(--border-color);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
      {footerColumns.map((column) => (
        <div class="space-y-6">
          {column.map((section) => (
            <div>
              <a
                href={section.href}
                class="text-xs font-semibold uppercase tracking-widest hover:underline"
                style="color: var(--text-primary);"
              >
                {section.label}
              </a>
              {section.children && (
                <ul class="mt-2 space-y-1">
                  {section.children.slice(0, 6).map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="text-sm transition-colors hover:underline"
                        style="color: var(--text-secondary);"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div
      class="border-t pt-6 flex flex-col sm:flex-row items-center justify-between gap-4"
      style="border-color: var(--border-color);"
    >
      <div class="flex flex-col sm:flex-row items-center gap-3 text-sm" style="color: var(--text-muted);">
        <span>
          İçerik
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="underline">
            CC BY-SA 4.0
          </a>
        </span>
        <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
        <span>
          Kod
          <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer" class="underline">
            MIT
          </a>
        </span>
        <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
        <span>Agentic AI Öğrenme Merkezi &copy; 2026</span>
      </div>

      <div class="flex items-center gap-4">
        <!-- RSS -->
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1.5 text-sm transition-colors hover:opacity-80"
          style="color: var(--text-secondary);"
          aria-label="RSS beslemesi"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/agenticai-tr/site"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm transition-colors hover:opacity-80"
          style="color: var(--text-secondary);"
          aria-label="GitHub deposu"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
