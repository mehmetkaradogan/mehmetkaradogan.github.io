---
// src/components/Sidebar.astro
// Full IA sidebar: collapsible sections, active-link highlight.
// Rendered server-side, toggled by CSS/minimal JS.

import { nav } from '@data/nav';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<!-- Desktop sidebar (always visible ≥lg) -->
<aside
  id="sidebar"
  aria-label="Site navigasyonu"
  class="hidden lg:flex flex-col w-64 shrink-0 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto border-r py-6 px-3 gap-1"
  style="background-color: var(--bg-surface); border-color: var(--border-color);"
>
  {nav.map((section) => {
    const sectionActive = isActive(section.href);

    if (!section.children) {
      return (
        <a
          href={section.href}
          class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${sectionActive ? 'font-semibold' : ''}`}
          style={sectionActive
            ? 'background-color: var(--color-primary-50); color: var(--color-primary-700);'
            : 'color: var(--text-secondary);'}
          aria-current={sectionActive ? 'page' : undefined}
        >
          {section.label}
        </a>
      );
    }

    // Section with children — collapsible
    return (
      <details class="group" open={sectionActive || undefined}>
        <summary
          class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm font-medium cursor-pointer select-none list-none transition-colors"
          style={sectionActive
            ? 'color: var(--color-primary-700); background-color: var(--color-primary-50);'
            : 'color: var(--text-secondary);'}
        >
          <a
            href={section.href}
            class="flex-1 hover:underline"
            onclick="arguments[0].stopPropagation()"
            style="color: inherit;"
          >
            {section.label}
          </a>
          <svg
            class="w-4 h-4 shrink-0 transition-transform group-open:rotate-90"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </summary>

        <ul class="mt-1 ml-3 border-l pl-3 space-y-0.5" style="border-color: var(--border-color);">
          {section.children.map((child) => {
            const childActive = currentPath === child.href;
            return (
              <li>
                <a
                  href={child.href}
                  class="block px-2 py-1.5 rounded-md text-xs transition-colors"
                  style={childActive
                    ? 'color: var(--color-primary-600); font-weight: 600; background-color: var(--color-primary-50);'
                    : 'color: var(--text-secondary);'}
                  aria-current={childActive ? 'page' : undefined}
                >
                  {child.label}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    );
  })}
</aside>

<!-- Mobile sidebar drawer (off-canvas) -->
<div
  id="mobile-sidebar-overlay"
  class="fixed inset-0 z-40 hidden lg:hidden"
  aria-hidden="true"
>
  <div
    id="mobile-sidebar-backdrop"
    class="absolute inset-0"
    style="background-color: rgba(0,0,0,0.5);"
  ></div>

  <aside
    id="mobile-sidebar-panel"
    class="absolute left-0 top-0 bottom-0 w-72 flex flex-col overflow-y-auto py-6 px-3 gap-1 shadow-xl"
    style="background-color: var(--bg-surface);"
    aria-label="Mobil navigasyon"
  >
    <div class="flex items-center justify-between px-3 mb-3">
      <a href="/" class="font-bold text-base" style="color: var(--brand);">
        Agentic AI Öğrenme Merkezi
      </a>
      <button
        id="mobile-sidebar-close"
        type="button"
        aria-label="Menüyü kapat"
        class="w-8 h-8 rounded-md flex items-center justify-center"
        style="color: var(--text-muted);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {nav.map((section) => {
      const sectionActive = isActive(section.href);

      if (!section.children) {
        return (
          <a
            href={section.href}
            class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors"
            style={sectionActive
              ? 'background-color: var(--color-primary-50); color: var(--color-primary-700);'
              : 'color: var(--text-secondary);'}
          >
            {section.label}
          </a>
        );
      }

      return (
        <details open={sectionActive || undefined}>
          <summary
            class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm font-medium cursor-pointer select-none list-none"
            style="color: var(--text-secondary);"
          >
            <a href={section.href} class="flex-1" onclick="arguments[0].stopPropagation()" style="color: inherit;">{section.label}</a>
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </summary>
          <ul class="mt-1 ml-3 border-l pl-3 space-y-0.5" style="border-color: var(--border-color);">
            {section.children.map((child) => (
              <li>
                <a href={child.href} class="block px-2 py-1.5 rounded-md text-xs" style="color: var(--text-secondary);">
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </aside>
</div>

<script>
  function initSidebar() {
    const overlay = document.getElementById('mobile-sidebar-overlay');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');
    const closeBtn = document.getElementById('mobile-sidebar-close');
    const openBtn = document.getElementById('sidebar-open-btn');

    function open() {
      overlay?.classList.remove('hidden');
      overlay?.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay?.classList.add('hidden');
      overlay?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    });
  }

  initSidebar();
  document.addEventListener('astro:after-swap', initSidebar);
</script>
