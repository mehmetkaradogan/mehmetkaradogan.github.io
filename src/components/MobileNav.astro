---
// src/components/MobileNav.astro
// Fixed bottom navigation bar for mobile: Ana / Ara / Roadmap / Videolar / Sözlük.

const links = [
  {
    label: 'Ana',
    href: '/',
    icon: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  },
  {
    label: 'Ara',
    href: '/arama',
    icon: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>`,
    triggerId: 'search-trigger',
  },
  {
    label: 'Roadmap',
    href: '/roadmap',
    icon: `<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>`,
  },
  {
    label: 'Videolar',
    href: '/videolar',
    icon: `<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>`,
  },
  {
    label: 'Sözlük',
    href: '/sozluk',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
  },
];

const current = Astro.url.pathname;
---

<nav
  aria-label="Mobil alt navigasyon"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-50 border-t flex items-center"
  style="background-color: var(--bg-surface); border-color: var(--border-color); padding-bottom: env(safe-area-inset-bottom, 0);"
>
  {links.map((link) => {
    const isActive = link.href === '/'
      ? current === '/'
      : current === link.href || current.startsWith(link.href + '/');

    // Search opens modal rather than navigating
    if (link.triggerId) {
      return (
        <button
          type="button"
          onclick="document.getElementById('search-trigger')?.click()"
          class="flex flex-col items-center justify-center gap-0.5 flex-1 py-2 text-center transition-colors"
          style={isActive ? 'color: var(--brand);' : 'color: var(--text-muted);'}
          aria-label={link.label}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon} />
          <span class="text-xs">{link.label}</span>
        </button>
      );
    }

    return (
      <a
        href={link.href}
        class="flex flex-col items-center justify-center gap-0.5 flex-1 py-2 text-center transition-colors"
        style={isActive ? 'color: var(--brand);' : 'color: var(--text-muted);'}
        aria-current={isActive ? 'page' : undefined}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon} />
        <span class="text-xs">{link.label}</span>
      </a>
    );
  })}
</nav>
