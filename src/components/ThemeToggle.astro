---
// src/components/ThemeToggle.astro
// Accessible light/dark toggle button — self-contained, no props needed.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Tema değiştir"
  title="Tema değiştir"
  class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
  style="background-color: var(--bg-subtle); color: var(--text-secondary); --tw-ring-color: var(--brand);"
>
  <!-- Sun (shown in dark mode to switch to light) -->
  <svg
    id="tt-sun"
    class="hidden"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <!-- Moon (shown in light mode to switch to dark) -->
  <svg
    id="tt-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('tt-sun');
    const moon = document.getElementById('tt-moon');

    function sync() {
      const dark = document.documentElement.classList.contains('dark');
      sun?.classList.toggle('hidden', !dark);
      moon?.classList.toggle('hidden', dark);
      btn?.setAttribute('aria-pressed', String(dark));
    }

    sync();

    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      sync();
    });
  }

  // Run on initial load and after Astro view transitions
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
