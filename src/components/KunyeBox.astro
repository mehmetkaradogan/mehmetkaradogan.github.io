---
// src/components/KunyeBox.astro
// Renders the spec/metadata box for /araclar/* pages.

import Badge from './Badge.astro';

export interface Props {
  vendor: string;
  toolType: string;
  license: string;
  os: string[];
  primary_model: string;
  last_review: Date;
  status: 'active' | 'maintenance' | 'deprecated';
}

const { vendor, toolType, license, os, primary_model, last_review, status } = Astro.props;

const reviewFormatted = last_review.toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const rows = [
  { label: 'Üretici',        value: vendor },
  { label: 'Tür',            value: toolType },
  { label: 'Lisans',         value: license },
  { label: 'Platform',       value: os.join(', ') || '—' },
  { label: 'Ana Model',      value: primary_model },
  { label: 'Son İnceleme',   value: reviewFormatted },
];
---

<aside
  class="not-prose rounded-xl border p-5 mb-8"
  style="background-color: var(--bg-subtle); border-color: var(--border-color);"
  aria-label="Araç künyesi"
>
  <div class="flex items-center justify-between mb-4 gap-3 flex-wrap">
    <h2 class="text-sm font-bold uppercase tracking-wider" style="color: var(--text-primary);">Araç Künyesi</h2>
    <Badge label={status} variant={`status-${status}`} />
  </div>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
    {rows.map(({ label, value }) => (
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs font-medium uppercase tracking-wide" style="color: var(--text-muted);">{label}</dt>
        <dd class="text-sm" style="color: var(--text-primary);">{value}</dd>
      </div>
    ))}
  </dl>
</aside>
