---
// src/pages/sss.astro
// FAQ accordion grouped by category + FAQPage JSON-LD.

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { sss } from '../data/sss';

const SITE_URL = 'https://mehmetkaradogan.github.io';

// Group by category
const grouped = sss.reduce<Record<string, typeof sss>>((acc, item) => {
  const cat = item.category ?? 'Genel';
  if (!acc[cat]) acc[cat] = [];
  acc[cat]!.push(item);
  return acc;
}, {});

const categories = Object.keys(grouped).sort();

const categoryLabels: Record<string, string> = {
  'temel-kavramlar': 'Temel Kavramlar',
  'teknik':          'Teknik',
  'araclar':         'Araçlar',
  'baslangic':       'Başlangıç',
  'mimari':          'Mimari',
  'maliyet':         'Maliyet',
  'modeller':        'Modeller',
  'uretim':          'Üretim',
  'Genel':           'Genel',
};

// FAQPage JSON-LD
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${SITE_URL}/sss`,
  mainEntity: sss.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title="Sık Sorulan Sorular (SSS)"
  description="Agentic AI hakkında sık sorulan sorular: Agent nedir, hangi framework, maliyet kontrolü ve daha fazlası."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={[{ label: 'SSS' }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-3" style="color: var(--text-primary);">Sık Sorulan Sorular</h1>
      <p class="text-base" style="color: var(--text-secondary);">
        Agentic AI öğrenirken en çok sorulan sorular ve yanıtları.
      </p>
    </header>

    {sss.length > 0 ? (
      <div class="space-y-10">
        {categories.map((cat) => (
          <section aria-labelledby={`cat-${cat.toLowerCase().replace(/\s+/g, '-')}`}>
            <h2
              id={`cat-${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class="text-xl font-bold mb-4"
              style="color: var(--text-primary);"
            >
              {categoryLabels[cat] ?? cat}
            </h2>
            <div class="space-y-3">
              {grouped[cat]!.map((item) => (
                <details
                  class="group rounded-xl border overflow-hidden"
                  style="border-color: var(--border-color);"
                >
                  <summary
                    class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer select-none list-none font-semibold text-sm"
                    style="background-color: var(--bg-surface); color: var(--text-primary);"
                  >
                    <span>{item.q}</span>
                    <svg
                      class="shrink-0 w-5 h-5 transition-transform group-open:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      style="color: var(--text-muted);"
                    >
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </summary>
                  <div
                    class="px-5 py-4 text-sm leading-relaxed border-t"
                    style="background-color: var(--bg-subtle); color: var(--text-secondary); border-color: var(--border-color);"
                  >
                    {item.a}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border p-12 text-center" style="border-color: var(--border-color); background-color: var(--bg-surface);">
        <p class="text-lg font-semibold" style="color: var(--text-primary);">Yakında</p>
        <p class="mt-2 text-sm" style="color: var(--text-secondary);">SSS içeriği hazırlanıyor.</p>
      </div>
    )}

    <!-- CTA to ask questions -->
    <div
      class="mt-12 p-6 rounded-2xl border text-center"
      style="background-color: var(--bg-surface); border-color: var(--border-color);"
    >
      <p class="font-semibold text-base mb-2" style="color: var(--text-primary);">
        Sorunuzu bulamadınız mı?
      </p>
      <p class="text-sm mb-4" style="color: var(--text-secondary);">
        GitHub'da konu açın veya tartışma başlatın.
      </p>
      <a
        href="https://github.com/agenticai-tr/site/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white transition-all hover:opacity-90"
        style="background-color: var(--brand);"
      >
        GitHub'da sor
      </a>
    </div>
  </div>
</BaseLayout>
