---
// src/pages/index.astro
// Full homepage hub.

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { nav } from '@data/nav';
import { getCollection } from 'astro:content';

const PAGE_DESCRIPTION =
  'Türkçe Agentic AI öğrenme merkezi: kavramlar, araçlar, projeler. Sıfırdan ileri seviyeye kadar adım adım öğren.';

// Latest news (guard empty)
let latestNews: Array<{ title: string; summary: string; href: string; newsType: string; date: Date }> = [];
try {
  const haberler = await getCollection('haberler', (e) => !e.data.draft);
  const sorted = haberler.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  latestNews = sorted.slice(0, 3).map((e) => ({
    title: e.data.title,
    summary: e.data.summary,
    href: `/haberler/${e.slug}`,
    newsType: e.data.newsType,
    date: e.data.date,
  }));
} catch { /* collection may not exist yet */ }

// Popular comparisons — fixed
const popularComparisons = [
  {
    title: 'LangGraph vs CrewAI vs AutoGen',
    summary: 'Üretim için mi, prototip için mi? Hangi multi-agent framework size uygun?',
    href: '/karsilastirmalar/langgraph-vs-crewai-vs-autogen',
    level: 'orta' as const,
    tags: ['langgraph', 'crewai', 'autogen'],
  },
  {
    title: 'Claude Code vs Codex vs Antigravity',
    summary: 'Agentic kod geliştirme araçlarının kapsamlı karşılaştırması.',
    href: '/karsilastirmalar/claude-code-vs-codex-vs-antigravity',
    level: 'orta' as const,
    tags: ['claude-code', 'codex', 'antigravity'],
  },
];

// Quick start cards
const quickCards = [
  {
    label: 'Sıfırdan başla',
    desc: 'Temel kavramlardan başla',
    href: '/baslangic',
    icon: `<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>`,
    color: '#6366f1',
  },
  {
    label: 'Aracımı seç',
    desc: 'Hangi araç ne zaman?',
    href: '/karsilastirmalar/hangi-arac-ne-zaman',
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>`,
    color: '#8b5cf6',
  },
  {
    label: 'Proje yap',
    desc: 'Fikir bankası + rehberler',
    href: '/projeler',
    icon: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
    color: '#ec4899',
  },
  {
    label: 'Video izle',
    desc: 'Küratif video listesi',
    href: '/videolar',
    icon: `<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>`,
    color: '#f59e0b',
  },
];

// Category grid (main content sections)
const categoryGrid = nav.filter(
  (s) =>
    s.href !== '/' &&
    !['/videolar', '/sozluk', '/sss', '/haberler', '/roadmap', '/hakkinda', '/arama'].includes(s.href)
);

// Roadmap mini steps
const roadmapSteps = [
  { label: 'Python Temelleri', href: '/modul/01-temeller', step: '01' },
  { label: 'LLM & API', href: '/modul/01-temeller', step: '02' },
  { label: 'Tool Calling', href: '/modul/02-ilk-tool-calling', step: '03' },
  { label: 'RAG', href: '/modul/03-rag-kurulumu', step: '04' },
  { label: 'İlk Agent', href: '/baslangic/ilk-agent', step: '05' },
  { label: 'Framework', href: '/karsilastirmalar/hangi-arac-ne-zaman', step: '06' },
  { label: 'Multi-Agent', href: '/modul/05-crewai-multi-agent', step: '07' },
  { label: 'MCP', href: '/modul/06-mcp-sunucu-yazma', step: '08' },
  { label: 'Üretim', href: '/modul/09-multi-model-orkestrasyon', step: '09' },
];

const newsTypeBadgeMap: Record<string, string> = {
  launch:      'newsType-launch',
  update:      'newsType-update',
  deprecation: 'newsType-deprecation',
  research:    'newsType-research',
};
---

<BaseLayout title="Agentic AI Öğrenme Merkezi" description={PAGE_DESCRIPTION}>
  <!-- Hero -->
  <Hero />

  <!-- ================================================================
       QUICK START CARDS
  ================================================================ -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14" aria-labelledby="quick-start-heading">
    <h2 id="quick-start-heading" class="text-2xl font-bold mb-8 text-center" style="color: var(--text-primary);">
      Nereden başlayacaksın?
    </h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {quickCards.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col items-center gap-3 p-6 rounded-2xl border text-center transition-all hover:shadow-lg focus-visible:outline-none focus-visible:ring-2"
          style="background-color: var(--bg-surface); border-color: var(--border-color); --tw-ring-color: var(--brand);"
        >
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center"
            style={`background-color: ${card.color}1a; color: ${card.color};`}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={card.icon} />
          </div>
          <div>
            <p class="font-semibold text-sm group-hover:underline" style="color: var(--text-primary);">{card.label}</p>
            <p class="text-xs mt-0.5" style="color: var(--text-secondary);">{card.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ================================================================
       ROADMAP MINI
  ================================================================ -->
  <section
    class="py-10 border-y"
    style="border-color: var(--border-color); background-color: var(--bg-subtle);"
    aria-labelledby="roadmap-heading"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <h2 id="roadmap-heading" class="text-xl font-bold" style="color: var(--text-primary);">Öğrenme Yolu</h2>
        <a href="/roadmap" class="text-sm font-medium hover:underline" style="color: var(--brand);">
          Tam haritayı gör →
        </a>
      </div>
      <div class="flex items-center gap-2 flex-wrap" role="list" aria-label="Öğrenme adımları">
        {roadmapSteps.map((step, i) => (
          <div class="flex items-center gap-2" role="listitem">
            <a
              href={step.href}
              class="flex flex-col items-center gap-1 px-3 py-2 rounded-lg border text-center transition-all hover:shadow-sm min-w-[72px]"
              style="background-color: var(--bg-surface); border-color: var(--border-color);"
            >
              <span class="text-xs font-mono font-bold" style="color: var(--brand);">{step.step}</span>
              <span class="text-xs leading-tight" style="color: var(--text-secondary);">{step.label}</span>
            </a>
            {i < roadmapSteps.length - 1 && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-muted); flex-shrink: 0;">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       THIS WEEK'S HIGHLIGHTS (haberler)
  ================================================================ -->
  {latestNews.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14" aria-labelledby="news-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="news-heading" class="text-xl font-bold" style="color: var(--text-primary);">Bu Hafta Öne Çıkanlar</h2>
        <a href="/haberler" class="text-sm font-medium hover:underline" style="color: var(--brand);">
          Tüm haberler →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {latestNews.map((news) => (
          <a
            href={news.href}
            class="group flex flex-col gap-3 p-5 rounded-xl border transition-all hover:shadow-md"
            style="background-color: var(--bg-surface); border-color: var(--border-color);"
          >
            <div class="flex items-center justify-between gap-2">
              <Badge label={news.newsType} variant={newsTypeBadgeMap[news.newsType] ?? 'default'} />
              <time class="text-xs" style="color: var(--text-muted);" datetime={news.date.toISOString()}>
                {news.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' })}
              </time>
            </div>
            <h3 class="font-semibold text-sm leading-snug group-hover:underline" style="color: var(--text-primary);">
              {news.title}
            </h3>
            <p class="text-xs leading-relaxed" style="color: var(--text-secondary);">{news.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ================================================================
       POPULAR COMPARISONS
  ================================================================ -->
  <section
    class="py-10 border-y"
    style="border-color: var(--border-color); background-color: var(--bg-subtle);"
    aria-labelledby="comparisons-heading"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <h2 id="comparisons-heading" class="text-xl font-bold" style="color: var(--text-primary);">Popüler Karşılaştırmalar</h2>
        <a href="/karsilastirmalar" class="text-sm font-medium hover:underline" style="color: var(--brand);">
          Tümünü gör →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {popularComparisons.map((c) => (
          <Card
            title={c.title}
            summary={c.summary}
            href={c.href}
            level={c.level}
            tags={c.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       CATEGORY GRID
  ================================================================ -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14" aria-labelledby="categories-heading">
    <div class="text-center mb-10">
      <h2 id="categories-heading" class="text-2xl font-bold" style="color: var(--text-primary);">
        Ne öğrenmek istiyorsun?
      </h2>
      <p class="mt-2 text-sm" style="color: var(--text-secondary);">
        Her bölüm bağımsız — istediğin yerden başla.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categoryGrid.map((section) => (
        <a
          href={section.href}
          class="group flex flex-col gap-3 p-5 rounded-xl border transition-all hover:shadow-md focus-visible:outline-none focus-visible:ring-2"
          style="background-color: var(--bg-surface); border-color: var(--border-color); --tw-ring-color: var(--brand);"
        >
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-semibold text-base group-hover:underline" style="color: var(--text-primary);">
              {section.label}
            </h3>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 transition-transform group-hover:translate-x-0.5" style="color: var(--text-muted);" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
          {section.children && (
            <ul class="space-y-1">
              {section.children.slice(0, 4).map((child) => (
                <li class="text-xs" style="color: var(--text-secondary);">· {child.label}</li>
              ))}
              {section.children.length > 4 && (
                <li class="text-xs" style="color: var(--text-muted);">+{section.children.length - 4} daha…</li>
              )}
            </ul>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- ================================================================
       FEATURES / WHY
  ================================================================ -->
  <section
    class="py-12 border-y"
    style="border-color: var(--border-color); background-color: var(--bg-subtle);"
    aria-labelledby="features-heading"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="features-heading" class="sr-only">Neden bu kaynak?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: 'Tamamen Türkçe',
            body: 'Teknik terimlerin Türkçe açıklamaları, kod örnekleri ve diyagramlar. Anadilinde öğren.',
            icon: `<path d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 0 1 6.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>`,
          },
          {
            title: 'Güncel & Kapsamlı',
            body: '2026 Mayıs itibarıyla MCP, A2A, LangGraph, CrewAI, Claude Code, Google Antigravity — hepsi burada.',
            icon: `<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>`,
          },
          {
            title: 'Uygulamalı Modüller',
            body: '9 adımlı modül serisi: kurulumdan üretim sistemine kadar gerçek kod ve projelerle öğren.',
            icon: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
          },
        ].map((f) => (
          <div class="flex flex-col gap-3">
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center"
              style="background-color: var(--color-primary-100); color: var(--color-primary-600);"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            </div>
            <h3 class="font-semibold text-base" style="color: var(--text-primary);">{f.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       NEWSLETTER / RSS CALLOUT
  ================================================================ -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center" aria-labelledby="rss-heading">
    <div
      class="rounded-2xl border p-8 sm:p-12"
      style="background-color: var(--bg-surface); border-color: var(--border-color);"
    >
      <h2 id="rss-heading" class="text-xl font-bold mb-3" style="color: var(--text-primary);">
        Güncel kal
      </h2>
      <p class="text-sm mb-6 max-w-lg mx-auto" style="color: var(--text-secondary);">
        Yeni araç incelemeleri, modül güncellemeleri ve Türkçe içerikler RSS ile takip edin.
      </p>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-white transition-all hover:opacity-90 text-sm"
        style="background-color: var(--brand);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        RSS beslemesi
      </a>
    </div>
  </section>
</BaseLayout>
