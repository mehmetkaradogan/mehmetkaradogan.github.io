---
// src/pages/modul/index.astro
// Modules sorted by modul number field.

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('modul', (e) => !e.data.draft);
// Sort by modul number string (e.g. "01", "02"...)
const sorted = entries.sort((a, b) => a.data.modul.localeCompare(b.data.modul));
---

<BaseLayout
  title="Modüller"
  description="9 adımlı Agentic AI eğitim modülleri: kurulumdan üretim sistemine kadar adım adım öğren."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={[{ label: 'Modüller' }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Eğitim Modülleri</h1>
      <p class="mt-2 text-base" style="color: var(--text-secondary);">
        Sıfırdan üretim sistemine 9 adım: her modülde pratik kod, egzersizler ve çıktı hedefleri.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="flex flex-col gap-4">
        {sorted.map((entry) => (
          <a
            href={`/modul/${entry.slug}`}
            class="group flex items-start gap-5 p-5 rounded-xl border transition-all hover:shadow-md"
            style="background-color: var(--bg-surface); border-color: var(--border-color);"
          >
            <!-- Module number -->
            <div
              class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center font-black text-lg"
              style="background-color: var(--color-primary-100); color: var(--color-primary-700);"
            >
              {entry.data.modul}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3 mb-1">
                <h2 class="font-semibold text-base group-hover:underline" style="color: var(--text-primary);">
                  {entry.data.title}
                </h2>
                <span class="shrink-0 text-xs" style="color: var(--text-muted);">{entry.data.sure}</span>
              </div>
              <p class="text-sm" style="color: var(--text-secondary);">{entry.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border p-12 text-center" style="border-color: var(--border-color); background-color: var(--bg-surface);">
        <p class="text-lg font-semibold" style="color: var(--text-primary);">Yakında</p>
        <p class="mt-2 text-sm" style="color: var(--text-secondary);">Modüller hazırlanıyor.</p>
      </div>
    )}
  </div>
</BaseLayout>
