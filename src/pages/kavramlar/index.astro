---
// src/pages/kavramlar/index.astro

import BaseLayout from '@layouts/BaseLayout.astro';
import Card from '@components/Card.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('kavramlar', (e) => !e.data.draft);
const sorted = entries.sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
---

<BaseLayout
  title="Kavramlar"
  description="Agentic AI temel kavramları: tool use, planning, memory, reflection, multi-agent sistemler ve daha fazlası."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={[{ label: 'Kavramlar' }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Kavramlar</h1>
      <p class="mt-2 text-base" style="color: var(--text-secondary);">
        Tool use, planning, memory, reflection ve daha fazlası — tüm temel kavramlar Türkçe.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sorted.map((entry) => (
          <Card
            title={entry.data.title}
            summary={entry.data.summary}
            href={`/kavramlar/${entry.slug}`}
            level={entry.data.level}
            tags={entry.data.tags}
            updated={entry.data.updated}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-xl border p-12 text-center" style="border-color: var(--border-color); background-color: var(--bg-surface);">
        <p class="text-lg font-semibold" style="color: var(--text-primary);">Yakında</p>
        <p class="mt-2 text-sm" style="color: var(--text-secondary);">Kavram sayfaları hazırlanıyor.</p>
      </div>
    )}
  </div>
</BaseLayout>
