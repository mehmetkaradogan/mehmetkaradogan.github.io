---
// src/pages/projeler/index.astro

import BaseLayout from '@layouts/BaseLayout.astro';
import Card from '@components/Card.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('projeler', (e) => !e.data.draft);

// Group by seviye
const severityOrder = { baslangic: 0, orta: 1, ileri: 2 };
const sorted = entries.sort((a, b) => severityOrder[a.data.seviye] - severityOrder[b.data.seviye]);

const seviyeLabels: Record<string, string> = {
  baslangic: 'Başlangıç Projeleri',
  orta:      'Orta Seviye Projeler',
  ileri:     'İleri Seviye Projeler',
};

const grouped = sorted.reduce<Record<string, typeof sorted>>((acc, entry) => {
  const key = entry.data.seviye;
  if (!acc[key]) acc[key] = [];
  acc[key]!.push(entry);
  return acc;
}, {});
---

<BaseLayout
  title="Projeler"
  description="Agentic AI proje fikirleri ve rehberleri: başlangıçtan ileri seviyeye kadar gerçek uygulamalar."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={[{ label: 'Projeler' }]} />

    <header class="mb-8">
      <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Projeler</h1>
      <p class="mt-2 text-base" style="color: var(--text-secondary);">
        Fikir bankasından üretim projelerine — uygulamalı öğrenme için rehberli projeler.
      </p>
    </header>

    {sorted.length > 0 ? (
      <div class="space-y-12">
        {(['baslangic', 'orta', 'ileri'] as const).map((seviye) => {
          const group = grouped[seviye];
          if (!group || group.length === 0) return null;
          return (
            <section aria-labelledby={`section-${seviye}`}>
              <h2 id={`section-${seviye}`} class="text-xl font-bold mb-4" style="color: var(--text-primary);">
                {seviyeLabels[seviye]}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {group.map((entry) => (
                  <Card
                    title={entry.data.title}
                    summary={entry.data.summary}
                    href={`/projeler/${entry.slug}`}
                    level={entry.data.level}
                    tags={entry.data.tags}
                    updated={entry.data.updated}
                  />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <div class="rounded-xl border p-12 text-center" style="border-color: var(--border-color); background-color: var(--bg-surface);">
        <p class="text-lg font-semibold" style="color: var(--text-primary);">Yakında</p>
        <p class="mt-2 text-sm" style="color: var(--text-secondary);">Proje sayfaları hazırlanıyor.</p>
      </div>
    )}
  </div>
</BaseLayout>
